{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "react-video-kit#dev": {
      "dependsOn": ["react-video-kit#build"],
      "cache": false,
      "persistent": true
    },
    "docs#dev": {
      "dependsOn": ["react-video-kit#build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "check": {
      "dependsOn": [
        "^build"
      ]
    },
    "size": {
      "dependsOn": [
        "build"
      ]
    },
    "lint:pkg": {
      "dependsOn": [
        "build"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ]
    },
    "test:ssr": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    }
  }
}
