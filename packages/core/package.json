{
  "name": "react-video-kit",
  "version": "3.0.0",
  "description": "A composable, plugin-first React video player inspired by the iOS player",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENCE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./primitives": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "default": "./dist/player/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "default": "./dist/compat/index.js"
    },
    "./fullscreen": {
      "types": "./dist/plugins/fullscreen/index.d.ts",
      "default": "./dist/plugins/fullscreen/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs && node scripts/check-dist.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test:treeshake": "node scripts/check-treeshake.mjs"
  },
  "peerDependencies": {
    "dashjs": "^5.0.0",
    "hls.js": "^1.7.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "dashjs": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "lightningcss": "1.33.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup": "4.67.5",
    "tsdown": "0.23.5",
    "typescript": "6.0.3",
    "webpack": "5.112.2"
  },
  "author": "Mohamed Achaq <hi@achaq.dev>",
  "homepage": "https://react-vide-kit.chaqchase.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaqchase/react-video.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/chaqchase/react-video/issues"
  },
  "keywords": [
    "react",
    "video",
    "player",
    "video-player",
    "hls",
    "dash",
    "headless",
    "plugins",
    "ios",
    "react-video-kit"
  ]
}
