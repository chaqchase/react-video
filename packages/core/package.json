{
  "name": "react-video-kit",
  "version": "3.0.0",
  "description": "A composable, plugin-first React video player inspired by the iOS player",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENCE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./primitives": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "default": "./dist/player/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "default": "./dist/compat/index.js"
    },
    "./fullscreen": {
      "types": "./dist/plugins/fullscreen/index.d.ts",
      "default": "./dist/plugins/fullscreen/index.js"
    },
    "./pip": {
      "types": "./dist/plugins/pip/index.d.ts",
      "default": "./dist/plugins/pip/index.js"
    },
    "./idle": {
      "types": "./dist/plugins/idle/index.d.ts",
      "default": "./dist/plugins/idle/index.js"
    },
    "./gestures": {
      "types": "./dist/plugins/gestures/index.d.ts",
      "default": "./dist/plugins/gestures/index.js"
    },
    "./hotkeys": {
      "types": "./dist/plugins/hotkeys/index.d.ts",
      "default": "./dist/plugins/hotkeys/index.js"
    },
    "./speed": {
      "types": "./dist/plugins/speed/index.d.ts",
      "default": "./dist/plugins/speed/index.js"
    },
    "./quality": {
      "types": "./dist/plugins/quality/index.d.ts",
      "default": "./dist/plugins/quality/index.js"
    },
    "./audio-tracks": {
      "types": "./dist/plugins/audio-tracks/index.d.ts",
      "default": "./dist/plugins/audio-tracks/index.js"
    },
    "./captions": {
      "types": "./dist/plugins/captions/index.d.ts",
      "default": "./dist/plugins/captions/index.js"
    },
    "./thumbnails": {
      "types": "./dist/plugins/thumbnails/index.d.ts",
      "default": "./dist/plugins/thumbnails/index.js"
    },
    "./chapters": {
      "types": "./dist/plugins/chapters/index.d.ts",
      "default": "./dist/plugins/chapters/index.js"
    },
    "./persistence": {
      "types": "./dist/plugins/persistence/index.d.ts",
      "default": "./dist/plugins/persistence/index.js"
    },
    "./media-session": {
      "types": "./dist/plugins/media-session/index.d.ts",
      "default": "./dist/plugins/media-session/index.js"
    },
    "./i18n": {
      "types": "./dist/plugins/i18n/index.d.ts",
      "default": "./dist/plugins/i18n/index.js"
    },
    "./autoplay": {
      "types": "./dist/plugins/autoplay/index.d.ts",
      "default": "./dist/plugins/autoplay/index.js"
    },
    "./recovery": {
      "types": "./dist/plugins/recovery/index.d.ts",
      "default": "./dist/plugins/recovery/index.js"
    },
    "./analytics": {
      "types": "./dist/plugins/analytics/index.d.ts",
      "default": "./dist/plugins/analytics/index.js"
    },
    "./i18n/ar": {
      "types": "./dist/plugins/i18n/ar.d.ts",
      "default": "./dist/plugins/i18n/ar.js"
    },
    "./i18n/es": {
      "types": "./dist/plugins/i18n/es.d.ts",
      "default": "./dist/plugins/i18n/es.js"
    },
    "./i18n/fr": {
      "types": "./dist/plugins/i18n/fr.d.ts",
      "default": "./dist/plugins/i18n/fr.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs && node scripts/check-dist.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test:treeshake": "node scripts/check-treeshake.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:react18": "REACT_VERSION=18 vitest run",
    "size": "size-limit",
    "lint:pkg": "node scripts/check-package.mjs",
    "test:ssr": "node scripts/check-ssr.mjs"
  },
  "peerDependencies": {
    "dashjs": "^5.0.0",
    "hls.js": "^1.7.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "dashjs": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@repo/eslint-config": "workspace:*",
    "@repo/react-18": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@size-limit/preset-small-lib": "14.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "happy-dom": "21.0.4",
    "lightningcss": "1.33.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup": "4.67.5",
    "size-limit": "14.3.0",
    "tsdown": "0.23.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "webpack": "5.112.2"
  },
  "author": "Mohamed Achaq <hi@achaq.dev>",
  "homepage": "https://react-vide-kit.chaqchase.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaqchase/react-video.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/chaqchase/react-video/issues"
  },
  "keywords": [
    "react",
    "video",
    "player",
    "video-player",
    "hls",
    "dash",
    "headless",
    "plugins",
    "ios",
    "react-video-kit"
  ]
}
