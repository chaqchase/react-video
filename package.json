{
  "name": "react-video",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "rimraf --glob \"packages/*/dist\" \"**/.turbo\" \"**/.next\" \"**/node_modules\"",
    "test": "turbo run test",
    "size": "turbo run size",
    "lint:pkg": "turbo run lint:pkg",
    "test:e2e": "turbo run test:e2e",
    "media": "pnpm --filter docs media",
    "test:ssr": "turbo run test:ssr",
    "check": "turbo run check"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "prettier": "^3.2.5",
    "rimraf": "^6.0.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=22"
  }
}
